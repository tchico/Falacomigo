  "tips": [
    {
      "match": "ão|ãe|õe",
      "tip": "Say “ow” like in “cow”, then hum it through your nose.",
      "anchor": "cow",
      "emoji": "🐄"
    },
    {
      "match": "lh",
      "tip": "“lh” is the “lli” in “million”.",
      "anchor": "million",
      "emoji": "💰"
    },
    {
      "match": "nh",
      "tip": "“nh” is the “ny” in “canyon”.",
      "anchor": "canyon",
      "emoji": "🏜️"
    },
    {
      "match": "^r|rr",
      "tip": "This “r” is a soft gargle at the back of your throat, like a sleepy lion.",
      "anchor": "lion",
      "emoji": "🦁"
    },
    {
      "match": "ã|[aeiou][mn]$|[aeiou]ns$",
      "tip": "Hum the end through your nose, like the “ng” in “sing”.",
      "anchor": "sing",
      "emoji": "🎵"
    },
    {
      "match": "j|g[ei]",
      "tip": "This sound is the “s” in “treasure”.",
      "anchor": "treasure",
      "emoji": "💎"
    },
    {
      "match": "ch|x",
      "tip": "“ch” says “sh”, like “shh!” for quiet.",
      "anchor": "shh",
      "emoji": "🤫"
    },
    {
      "match": "s$|s[^aeiouáéíóúâêôãõ]",
      "tip": "An “s” at the end says “sh”, like a sleepy snake.",
      "anchor": "snake",
      "emoji": "🐍"
    },
    {
      "match": "ç",
      "tip": "“ç” is just “s”, like in “sun”.",
      "anchor": "sun",
      "emoji": "☀️"
    },
    {
      "match": "[^éê]e$",
      "tip": "The “e” at the end is tiny, almost silent.",
      "anchor": "tiny",
      "emoji": "🤏"
    },
    {
      "match": "[^ô]o$",
      "tip": "An “o” at the end says “oo”, like in “zoo”.",
      "anchor": "zoo",
      "emoji": "🦓"
    }
  ]
}
