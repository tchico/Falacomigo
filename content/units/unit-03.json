  "scenes": [
    {
      "id": "S3.1",
      "title": "Posso brincar?",
      "titleEn": "Can I play?",
      "setting": "beach-castle",
      "beats": [
        {"id": "b1", "say": {"speaker": "gui", "text": "Chegámos à praia! Que sol! Olha, dois meninos a fazer um castelo de areia.", "en": "We've reached the beach! So sunny! Look, two children making a sandcastle."}, "expect": null},
        {"id": "b2", "say": {"speaker": "rita", "text": "Olá! Eu sou a Rita e este é o Duarte, o meu irmão. Somos do Porto!", "en": "Hello! I'm Rita and this is Duarte, my brother. We're from Porto!"}, "expect": null},
        {"id": "b3", "say": {"speaker": "rita", "text": "Estamos a fazer um castelo enorme! Hmm… queres alguma coisa?", "en": "We're making a huge castle! Hmm… do you want something?"}, "expect": "P29", "recast": "Claro que podes! Anda!"},
        {"id": "b4", "say": {"speaker": "duarte", "text": "Temos de ir buscar água ao mar. Quem vai primeiro?", "en": "We need to fetch water from the sea. Who goes first?"}, "expect": "P32", "answers": [{"accept": ["e a tua vez", "a tua vez", "tua vez", "vai tu", "tu primeiro", "primeiro tu", "es tu"], "recast": "Eu primeiro? Obrigado! Já volto!"}], "recast": "É a tua vez! Toma o balde!"},
        {"id": "b5", "ages": [8], "say": {"speaker": "rita", "text": "Eu tenho a pá e o balde. Precisas de alguma coisa?", "en": "I've got the spade and the bucket. Do you need anything?"}, "expect": "P34", "image": "beach:bucket", "recast": "Claro! Toma, podes usar."},
        {"id": "b5y", "ages": [6], "say": {"speaker": "rita", "text": "Olha, o balde! Toma, é para ti.", "en": "Look, the bucket! Here, it's for you."}, "expect": null, "image": "beach:bucket"},
        {"id": "b6", "say": {"speaker": "gui", "text": "O castelo está pronto! Que tal? Gostas?", "en": "The castle is ready! What do you think? Do you like it?"}, "model": "Que divertido!", "expect": "P41", "answers": [{"accept": ["nao gosto", "nao gosto muito", "nao e giro", "nao"], "recast": "Não gostas? Amanhã fazemos um ainda maior!"}], "recast": "Que divertido, não é?"},
        {"id": "b7", "say": {"speaker": "gui", "text": "Oh, não! Olha o mar… vem aí uma onda enorme!", "en": "Oh no! Look at the sea… a huge wave is coming!"}, "expect": null, "cliffhanger": true}
      ]
    },
    {
      "id": "S3.2",
      "title": "Vamos jogar à bola!",
      "titleEn": "Let's play ball!",
      "setting": "beach-ball",
      "beats": [
        {"id": "b1", "say": {"speaker": "duarte", "text": "A onda levou o castelo! Não faz mal. Temos uma bola. O que fazemos agora?", "en": "The wave took the castle! Never mind. We've got a ball. What shall we do now?"}, "expect": "P31", "image": "beach:ball", "recast": "Boa ideia! Vamos jogar à bola!"},
        {"id": "b2", "say": {"speaker": "gui", "text": "Eu também quero jogar! Mas estou tão longe… onde fico?", "en": "I want to play too! But I'm so far away… where do I go?"}, "model": "Anda cá!", "expect": "P37", "recast": "Vou já! Voo, voo, voo!"},
        {"id": "b3", "ages": [8], "say": {"speaker": "rita", "text": "Quem atira a bola agora? Sou eu ou és tu?", "en": "Who throws the ball now? Me or you?"}, "expect": "P33", "answers": [{"accept": ["e a minha vez", "a minha vez", "minha vez", "agora sou eu", "sou eu", "eu primeiro"], "recast": "É a tua vez? Está bem, apanha!"}], "recast": "Obrigada! Apanha, Duarte!"},
        {"id": "b4", "say": {"speaker": "duarte", "text": "Ai! A bola bateu-me na cabeça!", "en": "Ouch! The ball hit me on the head!"}, "model": "Desculpa!", "expect": "P42", "recast": "Não faz mal! Estou bem!"},
        {"id": "b5", "say": {"speaker": "duarte", "text": "Corrida até ao mar! Um, dois, três… já!", "en": "Race to the sea! One, two, three… go!"}, "model": "Espera por mim!", "expect": "P38", "recast": "Está bem, eu espero! Vamos juntos!"},
        {"id": "b6", "say": {"speaker": "rita", "text": "Chegaste primeiro ao mar! Quem ganhou?", "en": "You got to the sea first! Who won?"}, "expect": "P39", "answers": [{"accept": ["tu ganhaste", "ganhaste tu", "a rita ganhou", "o duarte ganhou", "eu perdi", "perdi"], "recast": "Eu? Não, ganhaste tu! Chegaste primeiro!"}], "recast": "Ganhaste! Parabéns!"},
        {"id": "b7", "say": {"speaker": "gui", "text": "Olha! O Duarte tem um gelado… mas só tem um. Hmm…", "en": "Look! Duarte has an ice cream… but he's only got one. Hmm…"}, "expect": null, "cliffhanger": true}
      ]
    },
    {
      "id": "S3.3",
      "title": "Partilhar é fixe",
      "titleEn": "Sharing is cool",
      "setting": "beach-evening",
      "beats": [
        {"id": "b1", "ages": [8], "say": {"speaker": "duarte", "text": "Tenho um gelado, mas somos muitos. O que fazemos?", "en": "I've got one ice cream, but there are lots of us. What shall we do?"}, "expect": "P36", "image": "beach:icecream", "recast": "Boa ideia! Um bocadinho para cada um!"},
        {"id": "b1y", "ages": [6], "say": {"speaker": "gui", "text": "Só um gelado? Não faz mal. Vamos partilhar!", "en": "Only one ice cream? Never mind. Let's share!"}, "expect": null, "image": "beach:icecream"},
        {"id": "b2", "say": {"speaker": "rita", "text": "E eu? Eu também quero um bocadinho!", "en": "What about me? I want a little bit too!"}, "model": "Toma, é para ti.", "expect": "P35", "image": "beach:icecream", "recast": "Obrigada! Hmm, que bom!"},
        {"id": "b3", "say": {"speaker": "gui", "text": "Isto é tão divertido! Mais um jogo?", "en": "This is such fun! One more game?"}, "model": "Outra vez!", "expect": "P40", "answers": [{"accept": ["nao", "nao obrigado", "nao obrigada", "ja chega", "agora nao", "nao quero"], "recast": "Já chega? Está bem, descansamos um bocadinho."}], "recast": "Outra vez! Vamos lá!"},
        {"id": "b4", "ages": [8], "say": {"speaker": "rita", "text": "Ufa! Corremos tanto. E tu, como estás?", "en": "Phew! We ran so much. How about you, how are you?"}, "expect": "P43", "answers": [{"accept": ["estou bem", "bem", "estou otimo", "estou otima", "nao estou cansado", "nao estou cansada", "estou fixe"], "recast": "Estás bem? Que energia!"}], "recast": "Eu também estou cansada!"},
        {"id": "b5", "ages": [8], "say": {"speaker": "gui", "text": "Ai… a Rita e o Duarte vão embora. Agora ninguém brinca comigo…", "en": "Oh… Rita and Duarte are leaving. Now nobody will play with me…"}, "model": "Queres brincar comigo?", "expect": "P30", "recast": "Quero! Quero muito! Obrigado!"},
        {"id": "b6", "say": {"speaker": "rita", "text": "Adeus! Até amanhã! Vemo-nos no Porto!", "en": "Bye! See you tomorrow! See you in Porto!"}, "expect": null},
        {"id": "b7", "say": {"speaker": "gui", "text": "Amanhã vamos para o Porto! Espera… onde está o meu mapa?", "en": "Tomorrow we're going to Porto! Wait… where's my map?"}, "expect": null, "cliffhanger": true}
      ]
    }
  ],
