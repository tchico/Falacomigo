      "accept": ["este e o meu irmao", "esta e a minha irma", "e o meu irmao", "e a minha irma", "este e o meu {sibling}", "esta e a minha {sibling}", "este e o {sibling}", "esta e a {sibling}", "o meu irmao", "a minha irma"],
