        { "id": "b2", "say": { "speaker": "gui", "text": "E esta? É uma gaivota?", "en": "And this one? Is she a seagull?" }, "image": "photo:mum", "model": "Não! É a minha mãe.", "expect": "P07", "accept": ["nao e a minha mae", "e a minha mae", "esta e a minha mae", "a minha mae", "nao a mae", "a mae", "mae", "nao"], "keywords": ["mae", "nao"], "recast": "Ahh, é a tua mãe! Desculpa!" },
        { "id": "b3", "say": { "speaker": "gui", "text": "E quem é este aqui?", "en": "And who's this one here?" }, "image": "photo:sibling", "expect": "P07", "recast": "É o teu {sibling}!" },
        { "id": "b4", "say": { "speaker": "gui", "text": "E este? Quem é?", "en": "And this one? Who is it?" }, "image": "photo:child", "model": "Sou eu! Tenho {age} anos.", "expect": "P05", "accept": ["sou eu", "e eu", "sou eu tenho {age} anos", "sou eu e tenho {age} anos", "tenho {age} anos"], "keywords": ["eu", "{age}"], "recast": "És tu! Com {age} anos!" },
        { "id": "b5", "say": { "speaker": "gui", "text": "E a tua avó? Onde está?", "en": "And your granny? Where is she?" }, "expect": null, "note": "Sets up Unit 7. Any answer is accepted." },
        { "id": "b6", "say": { "speaker": "gui", "text": "Olha aquele postal… é Lisboa! A minha casa!", "en": "Look at that postcard… it's Lisbon! My home!" }, "expect": null, "cliffhanger": true }
      ]
    },
    {
      "id": "S1.3",
      "title": "Onde estou?",
      "titleEn": "Where am I?",
      "setting": "garden-evening",
      "beats": [
        { "id": "b1", "say": { "speaker": "gui", "text": "Onde estou? Isto é Lisboa?", "en": "Where am I? Is this Lisbon?" }, "expect": "P08", "ages": [8], "recast": "Na Irlanda?! Tão longe!" },
        { "id": "b1y", "ages": [6], "say": { "speaker": "gui", "text": "Onde estou? Isto é Lisboa?", "en": "Where am I? Is this Lisbon?" }, "model": "Não! Na Irlanda.", "expect": "P08", "accept": ["nao irlanda", "irlanda", "nao", "na irlanda"], "keywords": ["irlanda", "nao"], "recast": "Na Irlanda?! Tão longe!" },
        { "id": "b2", "say": { "speaker": "gui", "text": "Ai… estou triste. Tenho saudades de casa.", "en": "Oh… I'm sad. I miss home." }, "model": "Como estás, Gui?", "expect": "P10", "accept": ["como estas", "como estas gui", "estas bem", "estas triste"], "keywords": ["como", "estas"], "recast": "Estou triste… mas tu és simpático!" },
        { "id": "b3", "say": { "speaker": "gui", "text": "Ajudas-me a voltar para casa? A sério? Toma uma bolacha!", "en": "Will you help me get home? Really? Have a biscuit!" }, "expect": "P09", "recast": "De nada!" },
        { "id": "b4", "say": { "speaker": "gui", "text": "Onde está o mapa? Chama-me!", "en": "Where's the map? Call me over!" }, "expect": "P11", "recast": "Já vou! Já vou!" },
        { "id": "b5", "say": { "speaker": "gui", "text": "Olha! O caminho até Lisboa! Primeiro… o ferry!", "en": "Look! The way to Lisbon! First… the ferry!" }, "expect": null },
        { "id": "b6", "say": { "speaker": "gui", "text": "Estou com sono… Boa noite!", "en": "I'm sleepy… Good night!" }, "model": "Boa noite! Até amanhã!", "expect": "P12", "accept": ["boa noite", "boa noite gui", "boa noite ate amanha", "ate amanha", "adeus ate amanha"], "keywords": ["noite", "amanha", "adeus"], "recast": "Boa noite! Até amanhã!", "unlocks": "unit-02" }
      ]
    }
