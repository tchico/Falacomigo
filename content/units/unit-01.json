{
  "$schema": "../schema/unit.schema.json",
  "id": "unit-01",
  "unit": 1,
  "title": "Olá! Eu e a minha família",
  "titleEn": "Hello! Me and my family",
  "stop": { "id": "garden", "name": "O jardim", "nameEn": "The back garden, Ireland" },
  "phrases": [
    {
