      "audio": { "dad": "P01.m4a", "ttsFallback": true }
    },
    {
      "id": "P02",
      "text": "Bom dia! / Boa tarde! / Boa noite!",
      "en": "Good morning! / Good afternoon! / Good night!",
      "accept": ["bom dia", "boa tarde", "boa noite", "bom dia pai", "boa noite pai", "bom dia gui", "boa noite gui"],
      "keywords": ["bom", "boa", "dia", "tarde", "noite"],
