        { "id": "b2", "say": { "speaker": "gui", "text": "Olá! Como te chamas?", "en": "Hello! What's your name?" }, "expect": "P03", "recast": "Chamas-te {name}? Que nome bonito!" },
        { "id": "b3", "say": { "speaker": "gui", "text": "Que nome bonito! Quantos anos tens?", "en": "What a lovely name! How old are you?" }, "expect": "P05", "recast": "Tens {age} anos? Já és grande!" },
        { "id": "b4a", "ages": [8], "say": { "speaker": "gui", "text": "Eu tenho… hmm… cem anos! E tu, perguntas-me alguma coisa?", "en": "I'm… hmm… a hundred! Aren't you going to ask me something?" }, "expect": "P04", "recast": "Como me chamo? Chamo-me Gui!" },
        { "id": "b4b", "ages": [6], "say": { "speaker": "gui", "text": "Eu tenho… hmm… cem anos! Chamo-me Gui. Diz: olá, Gui!", "en": "I'm… a hundred! My name is Gui. Say: hello, Gui!" }, "expect": "P01", "recast": "Olá! Sou o Gui!" },
        { "id": "b5", "say": { "speaker": "gui", "text": "Brrr… tenho frio! Como estás tu?", "en": "Brrr… I'm cold! How are you?" }, "model": "Estou bem!", "expect": "P10", "recast": "Estás bem? Que bom! Eu estou com frio!" },
        { "id": "b6", "say": { "speaker": "gui", "text": "Olha! Quem são aqueles na janela?", "en": "Look! Who are those people in the window?" }, "expect": null, "cliffhanger": true }
      ]
    },
