        {"id": "b4", "ages": [8], "say": {"speaker": "rita", "text": "Olá! Sou eu, a Rita, da praia! O que aconteceu?", "en": "Hello! It's me, Rita, from the beach! What happened?"}, "expect": "P45", "recast": "Perderam o mapa? Que chatice!"},
