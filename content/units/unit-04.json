        {"id": "b6", "say": {"speaker": "rita", "text": "Olha! Ali, na esplanada. Vês um papel? Onde está?", "en": "Look! Over there, at the café tables. Can you see a piece of paper? Where is it?"}, "expect": "P49", "image": "where:map-under-chair", "recast": "Debaixo da cadeira! Ah… não é o mapa, é só um guardanapo."},
