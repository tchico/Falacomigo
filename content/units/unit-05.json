        {"id": "b7", "say": {"speaker": "gui", "text": "Ai… preciso de um abraço…", "en": "Oh… I need a hug…"}, "model": "Toma um abraço!", "expect": "P71", "recast": "Que abraço tão bom! Já me sinto um bocadinho melhor."},
