        {"id": "b8", "say": {"speaker": "gui", "text": "A doutora diz que eu tenho de descansar…", "en": "The doctor says I have to rest…"}, "model": "Melhoras!", "expect": "P70", "recast": "Obrigado! Vou dormir um bocadinho."},
