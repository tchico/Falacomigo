        {"id": "b3", "say": {"speaker": "ze", "text": "O que queres comer? Temos pão, sopa e peixe.", "en": "What would you like to eat? We have bread, soup and fish."}, "expect": "P15", "image": "food:bread-soup-fish", "accept": ["eu quero pao por favor", "quero pao por favor", "eu quero pao", "quero pao", "pao por favor", "eu quero sopa por favor", "quero sopa por favor", "eu quero sopa", "quero sopa", "sopa por favor", "eu quero peixe por favor", "quero peixe por favor", "eu quero peixe", "quero peixe", "peixe por favor", "pao", "sopa", "peixe"], "keywords": ["quero", "pao", "sopa", "peixe"], "recast": "Muito bem pedido! Aqui está!"},
        {"id": "b4", "say": {"speaker": "ze", "text": "E para beber? Água ou leite?", "en": "And to drink? Water or milk?"}, "expect": "P16", "image": "drink:water-milk", "accept": ["posso ter agua por favor", "posso ter leite por favor", "posso ter agua", "posso ter leite", "agua por favor", "leite por favor", "quero agua", "quero leite", "quero agua por favor", "quero leite por favor", "agua", "leite"], "keywords": ["posso", "agua", "leite"], "recast": "Claro! Aqui está."},
