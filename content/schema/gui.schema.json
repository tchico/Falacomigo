{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gui's own lines outside the scenes: warm-up (FR-15), end of session (FR-16), album (FR-21), Como se diz (FR-11)",
  "type": "object",
  "required": ["warmup", "session", "album", "comoSeDiz"],
  "properties": {
    "$schema": { "type": "string" },
    "warmup": { "type": "object", "additionalProperties": { "type": "string" } },
    "session": {
      "type": "object",
      "required": ["aimMinutes"],
      "properties": { "aimMinutes": { "type": "number", "minimum": 5, "maximum": 30, "description": "After this long, Gui gets sleepy at the end of the next scene." } },
      "additionalProperties": { "type": ["string", "number"] }
    },
    "album": { "type": "object", "additionalProperties": { "type": "string" } },
    "comoSeDiz": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
