{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fala Comigo unit content pack",
  "type": "object",
  "required": ["id", "unit", "title", "stop", "phrases", "scenes", "missions"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^unit-\\d{2}$" },
    "unit": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "titleEn": { "type": "string" },
    "stop": {
      "type": "object",
      "required": ["id", "name"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "nameEn": { "type": "string" } }
    },
    "characters": {
      "type": "object",
      "description": "The unit's local characters, keyed by the speaker id used in beats. Gui is always there and isn't listed.",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "emoji"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "roleEn": { "type": "string" },
          "emoji": { "type": "string", "description": "Stand-in picture until there's an illustration." },
          "color": { "type": "string" }
        }
      }
    },
    "phrases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "en", "accept", "keywords", "ages", "startRung"],
        "properties": {
          "id": { "type": "string", "pattern": "^P\\d{2}$" },
          "text": { "type": "string", "description": "Shown and spoken. May contain {name}, {age}, {sibling}." },
          "en": { "type": "string" },
          "accept": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Normalised: lower case, no accents or punctuation." },
          "keywords": { "type": "array", "items": { "type": "string" }, "description": "Hearing some of these gives a Nearly result." },
          "ages": { "type": "array", "items": { "enum": [6, 8] } },
          "startRung": { "type": "integer", "minimum": 1, "maximum": 5 },
          "audio": { "type": "object", "properties": { "dad": { "type": "string" }, "ttsFallback": { "type": "boolean" } } }
        }
      }
    },
    "vocab": { "type": "array", "items": { "type": "object", "required": ["pt", "en"] } },
    "warmup": { "type": "array", "items": { "type": "string" } },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "beats"],
        "properties": {
          "beats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "say", "expect"],
              "properties": {
                "id": { "type": "string" },
                "ages": { "type": "array", "items": { "enum": [6, 8] } },
                "say": {
                  "type": "object",
                  "required": ["speaker", "text"],
                  "properties": {
                    "speaker": { "type": "string" },
                    "text": { "type": "string" },
                    "en": { "type": "string" },
                    "spoken": { "type": "string", "description": "What the voice says, when the written line has sounds text-to-speech can't do. Sounds like Hmm and Brrr are handled automatically." }
                  }
                },
                "expect": { "type": ["string", "null"], "description": "Phrase id the child should say, or null for a story beat." },
                "model": { "type": "string", "description": "What the child should say here, when it differs from the phrase text. Shown as the hint and spoken as the model." },
                "accept": { "type": "array", "items": { "type": "string" }, "description": "Overrides the phrase's accepted versions for this beat." },
                "keywords": { "type": "array", "items": { "type": "string" } },
                "recast": { "type": "string" },
                "answers": {
                  "type": "array",
                  "description": "Other real answers to an open question, each with the character's own reply. Accepted versions are normalised.",
                  "items": {
                    "type": "object",
                    "required": ["accept", "recast"],
                    "properties": {
                      "accept": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                      "recast": { "type": "string" }
                    }
                  }
                },
                "image": { "type": "string" },
                "cliffhanger": { "type": "boolean" },
                "unlocks": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "missions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "day", "card", "say", "targets"]
      }
    },
    "schedule": { "type": "object" }
  }
}
